        <mxCell id="2O3HAQBy4T7X0kwtkqwP-13" value="&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;Regression Analysis&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;i&gt;--&amp;gt; Can&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;color: rgb(51, 51, 51);&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;species richness,&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;/span&gt;&lt;i style=&quot;background-color: transparent; color: rgb(51, 51, 51);&quot;&gt;plant community richness,&lt;/i&gt;&lt;i style=&quot;background-color: transparent; color: rgb(51, 51, 51);&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;&amp;nbsp;and habitat type diversity&lt;/span&gt;&lt;/i&gt;&lt;i style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;&amp;nbsp;be predicted by the number of spectral species?&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;Unique_Plant_Communities&amp;nbsp;~ Unique_Spectral_Species&lt;/font&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-weight: 400;&quot;&gt;Unique_Plant_Types ~ Unique_Spectral_Species&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-weight: 400;&quot;&gt;Unique_Habitat_Types ~ Unique_Spectral_Species&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
